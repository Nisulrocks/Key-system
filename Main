-- Key System Module
-- Easy to configure for different scripts

local KeySystemConfig = {
    -- CHANGE THESE FOR EACH SCRIPT
    ScriptName = "PVB Auto Farm",
    Version = "1.0.0",
    CorrectKey = "CHANGE_THIS_KEY", -- Set your key here
    DiscordLink = "https://discord.gg/wN85KUq6nD", -- Set your Discord invite
    
    -- UI Settings
    Title = "Key System",
    Subtitle = "Enter your key to continue",
    KeyPlaceholder = "Enter Key Here...",
}

-- Services & visual palette for Red Protocol V8 UI
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")

local Colors = {
	Background = Color3.fromRGB(10, 10, 12),
	NeonRed = Color3.fromRGB(255, 30, 30),
	NeonGreen = Color3.fromRGB(0, 255, 120),
	Text = Color3.fromRGB(240, 240, 240),
	Gray = Color3.fromRGB(60, 60, 60),
}

-- Shared UI state
local ScreenGui
local MainCanvas

-- Key Storage Functions
local function GetKeyFileName()
    -- Use a stable StorageId if provided; otherwise fall back to ScriptName
    local base = KeySystemConfig.StorageId or KeySystemConfig.ScriptName
    base = tostring(base)
    local safeName = base:gsub("[^%w]", "_") -- Replace non-alphanumeric with underscore
    return safeName .. "_key.txt"
end

local function GetStoredKey()
    local fileName = GetKeyFileName()
    local success, result = pcall(function()
        return readfile(fileName)
    end)
    if success and result and result ~= "" then
        -- Trim whitespace
        result = result:match("^%s*(.-)%s*$")
        return result
    end
    return nil
end

local function SaveKey(key)
    local fileName = GetKeyFileName()
    local success, err = pcall(function()
        writefile(fileName, tostring(key))
    end)
    if not success then
        warn("Failed to save key:", err)
    end
    return success
end

local function ClearStoredKey()
    local fileName = GetKeyFileName()
    pcall(function()
        delfile(fileName)
    end)
end

-- Utility: Dragging helper for Red Protocol frame
local function MakeDraggable(frame, handle)
	local dragging, dragInput, dragStart, startPos
	local function update(input)
		local delta = input.Position - dragStart
		TweenService:Create(frame, TweenInfo.new(0.05), {
			Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		}):Play()
	end
	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = frame.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)
	handle.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			update(input)
		end
	end)
end

-- Red Protocol V8 animated key GUI
local function CreateKeyGUI()
	ScreenGui = Instance.new("ScreenGui")
	ScreenGui.Name = "RedProtocol_V8"
	ScreenGui.ResetOnSpawn = false
	ScreenGui.IgnoreGuiInset = true
	
	-- Safe Parent
	pcall(function() ScreenGui.Parent = CoreGui end)
	if not ScreenGui.Parent then
		ScreenGui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	end

	-- Determine target size based on current screen (mobile-friendly scaling)
	local viewportSize = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
	local targetWidth = math.clamp(viewportSize.X * 0.6, 320, 520)
	local targetHeight = math.clamp(viewportSize.Y * 0.3, 180, 260)

	-- Main Window (Started Small for Animation)
	MainCanvas = Instance.new("Frame")
	MainCanvas.Name = "MainCanvas"
	MainCanvas.Size = UDim2.new(0, 0, 0, 2)
	MainCanvas.Position = UDim2.new(0.5, 0, 0.5, 0)
	MainCanvas.AnchorPoint = Vector2.new(0.5, 0.5)
	MainCanvas.BackgroundColor3 = Colors.Background
	MainCanvas.BackgroundTransparency = 0.1
	MainCanvas.BorderSizePixel = 0
	MainCanvas.ClipsDescendants = true
	MainCanvas.Parent = ScreenGui

	-- Neon Glow Stroke
	local UIStroke = Instance.new("UIStroke")
	UIStroke.Parent = MainCanvas
	UIStroke.Color = Colors.NeonRed
	UIStroke.Thickness = 2
	UIStroke.Transparency = 0

	local UICorner = Instance.new("UICorner")
	UICorner.CornerRadius = UDim.new(0, 6)
	UICorner.Parent = MainCanvas

	-- Content container
	local ContentFrame = Instance.new("Frame")
	ContentFrame.Size = UDim2.new(1, 0, 1, 0)
	ContentFrame.BackgroundTransparency = 1
	ContentFrame.Parent = MainCanvas

	-- Title
	local Title = Instance.new("TextLabel")
	Title.Text = string.format("%s  <font color='#ff3333'>//  v%s</font>", KeySystemConfig.ScriptName, tostring(KeySystemConfig.Version or ""))
	Title.RichText = true
	Title.Size = UDim2.new(1, -40, 0, 40)
	Title.Position = UDim2.new(0, 20, 0, 10)
	Title.BackgroundTransparency = 1
	Title.TextColor3 = Colors.Text
	Title.Font = Enum.Font.GothamBlack
	Title.TextSize = 22
	Title.TextXAlignment = Enum.TextXAlignment.Left
	Title.TextTransparency = 1
	Title.Parent = ContentFrame

	MakeDraggable(MainCanvas, MainCanvas)

	-- Status text
	local Status = Instance.new("TextLabel")
	Status.Text = "Awaiting Input..."
	Status.Size = UDim2.new(1, -40, 0, 20)
	Status.Position = UDim2.new(0, 20, 0, 45)
	Status.BackgroundTransparency = 1
	Status.TextColor3 = Colors.Gray
	Status.Font = Enum.Font.Code
	Status.TextSize = 14
	Status.TextXAlignment = Enum.TextXAlignment.Left
	Status.TextTransparency = 1
	Status.Parent = ContentFrame

	-- Input box container
	local InputBg = Instance.new("Frame")
	InputBg.Size = UDim2.new(1, -40, 0, 50)
	InputBg.Position = UDim2.new(0, 20, 0, 80)
	InputBg.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	InputBg.BackgroundTransparency = 1
	InputBg.Parent = ContentFrame

	local InputCorner = Instance.new("UICorner")
	InputCorner.CornerRadius = UDim.new(0, 6)
	InputCorner.Parent = InputBg

	local InputStroke = Instance.new("UIStroke")
	InputStroke.Parent = InputBg
	InputStroke.Color = Colors.Gray
	InputStroke.Thickness = 1
	InputStroke.Transparency = 1

	local KeyBox = Instance.new("TextBox")
	KeyBox.Size = UDim2.new(1, -20, 1, 0)
	KeyBox.Position = UDim2.new(0, 10, 0, 0)
	KeyBox.BackgroundTransparency = 1
	KeyBox.Text = ""
	KeyBox.PlaceholderText = KeySystemConfig.KeyPlaceholder
	KeyBox.PlaceholderColor3 = Color3.fromRGB(100, 100, 100)
	KeyBox.TextColor3 = Colors.Text
	KeyBox.Font = Enum.Font.GothamBold
	KeyBox.TextSize = 14
	KeyBox.TextTransparency = 1
	KeyBox.Parent = InputBg

	-- Buttons
	local function CreateBtn(text, color, size, pos, callback)
		local btn = Instance.new("TextButton")
		btn.Size = size
		btn.Position = pos
		btn.BackgroundColor3 = color
		btn.BackgroundTransparency = 1
		btn.Text = text
		btn.TextColor3 = Colors.Text
		btn.Font = Enum.Font.GothamBold
		btn.TextSize = 14
		btn.TextTransparency = 1
		btn.Parent = ContentFrame
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 6)
		corner.Parent = btn
		btn.MouseButton1Click:Connect(callback)
		return btn
	end

	local leftSize = UDim2.new(0.44, 0, 0, 35)
	local rightSize = UDim2.new(0.44, 0, 0, 35)

	local DiscordButton = CreateBtn("GET KEY", Color3.fromRGB(40,40,40), leftSize, UDim2.new(0.04, 0, 1, -55), function()
		if setclipboard then
			setclipboard(KeySystemConfig.DiscordLink)
		end
		Status.Text = "> DISCORD LINK COPIED"
		Status.TextColor3 = Colors.NeonGreen
		task.delay(2, function()
			Status.Text = "Awaiting Input..."
			Status.TextColor3 = Colors.Gray
		end)
	end)

	local SubmitButton = CreateBtn("ENTER", Colors.NeonRed, rightSize, UDim2.new(0.52, 0, 1, -55), function() end)

	-- Startup animation
	TweenService:Create(MainCanvas, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Size = UDim2.new(0, targetWidth, 0, 2),
	}):Play()
	task.wait(0.6)
	TweenService:Create(MainCanvas, TweenInfo.new(0.6, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {
		Size = UDim2.new(0, targetWidth, 0, targetHeight),
	}):Play()
	task.wait(0.4)

	local function FadeIn(obj, delay)
		task.delay(delay, function()
			if obj:IsA("TextLabel") or obj:IsA("TextBox") or obj:IsA("TextButton") then
				TweenService:Create(obj, TweenInfo.new(0.5), { TextTransparency = 0 }):Play()
			end
			if obj == InputBg or obj:IsA("TextButton") then
				TweenService:Create(obj, TweenInfo.new(0.5), { BackgroundTransparency = 0 }):Play()
			end
			if obj:FindFirstChild("UIStroke") then
				TweenService:Create(obj.UIStroke, TweenInfo.new(0.5), { Transparency = 0.5 }):Play()
			end
		end)
	end

	FadeIn(Title, 0)
	FadeIn(Status, 0.1)
	FadeIn(InputBg, 0.2)
	FadeIn(KeyBox, 0.2)
	FadeIn(DiscordButton, 0.3)
	FadeIn(SubmitButton, 0.3)

	KeyBox.Focused:Connect(function()
		TweenService:Create(InputStroke, TweenInfo.new(0.3), { Color = Colors.NeonRed, Transparency = 0 }):Play()
	end)
	KeyBox.FocusLost:Connect(function()
		TweenService:Create(InputStroke, TweenInfo.new(0.3), { Color = Colors.Gray, Transparency = 0.5 }):Play()
	end)

	return ScreenGui, KeyBox, SubmitButton, DiscordButton, Status, MainCanvas, ContentFrame, UIStroke, InputBg, InputStroke, targetWidth
end

-- Show notification
local function ShowNotification(title, text, duration)
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = title,
        Text = text,
        Duration = duration or 5,
    })
end

-- Copy to clipboard
local function CopyToClipboard(text)
    if setclipboard then
        setclipboard(text)
        return true
    elseif syn and syn.write_clipboard then
        syn.write_clipboard(text)
        return true
    elseif Clipboard and Clipboard.set then
        Clipboard.set(text)
        return true
    end
    return false
end

-- Promise implementation (simple)
local Promise = {}
Promise.__index = Promise

function Promise.new(executor)
    local self = setmetatable({}, Promise)
    self._status = "pending"
    self._value = nil
    
    local function resolve(value)
        if self._status == "pending" then
            self._status = "resolved"
            self._value = value
            if self._then then
                self._then(value)
            end
        end
    end
    
    local function reject(reason)
        if self._status == "pending" then
            self._status = "rejected"
            self._value = reason
            if self._catch then
                self._catch(reason)
            end
        end
    end
    
    executor(resolve, reject)
    return self
end

function Promise:andThen(callback)
    self._then = callback
    if self._status == "resolved" then
        callback(self._value)
    end
    return self
end

function Promise:catch(callback)
    self._catch = callback
    if self._status == "rejected" then
        callback(self._value)
    end
    return self
end

-- Main Key System Function
local function ValidateKey()
    return Promise.new(function(resolve, reject)
        local Players = game:GetService("Players")
        local LocalPlayer = Players.LocalPlayer
        local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
        
        -- Check if stored key is valid
        local storedKey = GetStoredKey()
        if storedKey and storedKey == KeySystemConfig.CorrectKey then
            -- Key is valid and hasn't changed, auto-validate
            ShowNotification("Key Validated", "Welcome back! Loading script...", 3)
            task.wait(0.5)
            resolve(true)
            return
        elseif storedKey and storedKey ~= KeySystemConfig.CorrectKey then
            -- Key has changed, clear old key
            ClearStoredKey()
        end
        
        		-- Create GUI (Red Protocol V8)
		local ScreenGui, KeyBox, SubmitButton, DiscordButton, StatusLabel, MainCanvasRef, ContentFrameRef, UIStrokeRef, InputBgRef, InputStrokeRef, targetWidth = CreateKeyGUI()
		ScreenGui.Parent = PlayerGui
        
        local keyValidated = false
        
        			-- Discord Button Click (StatusLabel uses Red Protocol status line)
			DiscordButton.MouseButton1Click:Connect(function()
				if CopyToClipboard(KeySystemConfig.DiscordLink) then
					StatusLabel.Text = "> DISCORD LINK COPIED"
					StatusLabel.TextColor3 = Colors.NeonGreen
					ShowNotification("Discord Link Copied", "Paste it in your browser to join!", 5)
				else
					StatusLabel.Text = "Discord: " .. KeySystemConfig.DiscordLink
					StatusLabel.TextColor3 = Color3.fromRGB(150, 150, 200)
				end
				
				task.delay(3, function()
					if not keyValidated then
						StatusLabel.Text = "Awaiting Input..."
						StatusLabel.TextColor3 = Colors.Gray
					end
				end)
			end)
            
            -- Submit Button Click (Red Protocol success animation)
			SubmitButton.MouseButton1Click:Connect(function()
				local enteredKey = KeyBox.Text
				
				if enteredKey == "" then
					StatusLabel.Text = "⚠ Please enter a key"
					StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
					return
				end
				
				if enteredKey == KeySystemConfig.CorrectKey then
					keyValidated = true
					StatusLabel.Text = "✓ Key validated! Loading script..."
					StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
					
					-- Save the key for future use
					local saveSuccess = SaveKey(enteredKey)
					if saveSuccess then
						ShowNotification("Key Accepted & Saved", "You won't need to enter it again! Loading...", 3)
					else
						ShowNotification("Key Accepted", "Loading " .. KeySystemConfig.ScriptName .. "...", 3)
					end
					
					task.wait(0.5)
					
					-- Red Protocol success animation
					MainCanvasRef.Active = false
					
					-- 1. Fade out content
					for _, v in pairs(ContentFrameRef:GetDescendants()) do
						if v:IsA("TextLabel") or v:IsA("TextBox") or v:IsA("TextButton") then
							TweenService:Create(v, TweenInfo.new(0.2), { TextTransparency = 1 }):Play()
						end
						if v:IsA("Frame") or v:IsA("TextButton") then
							TweenService:Create(v, TweenInfo.new(0.2), { BackgroundTransparency = 1 }):Play()
						end
						if v:IsA("UIStroke") then
							TweenService:Create(v, TweenInfo.new(0.2), { Transparency = 1 }):Play()
						end
					end
					
					task.wait(0.2)
					
					-- 1.5 Welcome message
					local WelcomeLabel = Instance.new("TextLabel")
					WelcomeLabel.Size = UDim2.new(1, -40, 0, 32)
					WelcomeLabel.Position = UDim2.new(0, 20, 0.5, -16)
					WelcomeLabel.BackgroundTransparency = 1
					WelcomeLabel.Text = "Welcome to <font color='#ff3333'>Nisulrocks Scripts</font>"
					WelcomeLabel.RichText = true
					WelcomeLabel.TextColor3 = Colors.Text
					WelcomeLabel.Font = Enum.Font.GothamBold
					WelcomeLabel.TextSize = 22
					WelcomeLabel.TextXAlignment = Enum.TextXAlignment.Center
					WelcomeLabel.TextYAlignment = Enum.TextYAlignment.Center
					WelcomeLabel.TextTransparency = 1
					WelcomeLabel.Parent = ContentFrameRef
					
					TweenService:Create(WelcomeLabel, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { TextTransparency = 0 }):Play()
					task.wait(0.6)
					TweenService:Create(WelcomeLabel, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1 }):Play()
					task.wait(0.3)
					
					-- 2. Collapse height then width
					TweenService:Create(MainCanvasRef, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
						Size = UDim2.new(0, targetWidth, 0, 2),
					}):Play()
					task.wait(0.4)
					TweenService:Create(MainCanvasRef, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
						Size = UDim2.new(0, 0, 0, 0),
					}):Play()
					task.wait(0.3)
					
					ScreenGui:Destroy()
					resolve(true)
				else
					StatusLabel.Text = "Invalid key! Get the key from Discord."
					StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
					KeyBox.Text = ""
					
					-- Shake animation
					local originalPos = SubmitButton.Position
					for i = 1, 3 do
						SubmitButton.Position = originalPos + UDim2.new(0, 10, 0, 0)
						task.wait(0.05)
						SubmitButton.Position = originalPos - UDim2.new(0, 10, 0, 0)
						task.wait(0.05)
					end
					SubmitButton.Position = originalPos
				end
			end)
		
		-- Enter key support
		KeyBox.FocusLost:Connect(function(enterPressed)
            if enterPressed then
                SubmitButton.MouseButton1Click:Fire()
            end
        end)
    end)
end

-- Export
return {
    Config = KeySystemConfig,
    Validate = ValidateKey,
}

-- Key System Module
-- Easy to configure for different scripts

local KeySystemConfig = {
    -- CHANGE THESE FOR EACH SCRIPT
    ScriptName = "PVB Auto Farm V6.8.1",
    CorrectKey = "CHANGE_THIS_KEY", -- Set your key here
    DiscordLink = "https://discord.gg/wN85KUq6nD", -- Set your Discord invite
    
    -- UI Settings
    Title = "Key System",
    Subtitle = "Enter your key to continue",
    KeyPlaceholder = "Enter Key Here...",
}

-- Key Storage Functions
local function GetKeyFileName()
    -- Create unique filename based on script name to avoid conflicts
    local safeName = KeySystemConfig.ScriptName:gsub("[^%w]", "_") -- Replace non-alphanumeric with underscore
    return safeName .. "_key.txt"
end

local function GetStoredKey()
    local fileName = GetKeyFileName()
    local success, result = pcall(function()
        return readfile(fileName)
    end)
    if success and result and result ~= "" then
        -- Trim whitespace
        result = result:match("^%s*(.-)%s*$")
        return result
    end
    return nil
end

local function SaveKey(key)
    local fileName = GetKeyFileName()
    local success, err = pcall(function()
        writefile(fileName, tostring(key))
    end)
    if not success then
        warn("Failed to save key:", err)
    end
    return success
end

local function ClearStoredKey()
    local fileName = GetKeyFileName()
    pcall(function()
        delfile(fileName)
    end)
end

-- Key System GUI
local function CreateKeyGUI()
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "KeySystemGUI"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    ScreenGui.IgnoreGuiInset = true -- Better for mobile
    
    -- Detect if on mobile
    local UserInputService = game:GetService("UserInputService")
    local isMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
    
    -- Main Frame (responsive sizing)
    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    if isMobile then
        -- Mobile: Use more screen space with scale
        MainFrame.Size = UDim2.new(0.9, 0, 0, 350)
        MainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
        MainFrame.AnchorPoint = Vector2.new(0.5, 0.5)
    else
        -- Desktop: Fixed size
        MainFrame.Size = UDim2.new(0, 400, 0, 300)
        MainFrame.Position = UDim2.new(0.5, -200, 0.5, -150)
    end
    MainFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
    MainFrame.BorderSizePixel = 0
    MainFrame.Parent = ScreenGui
    
    -- Corner
    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 12)
    Corner.Parent = MainFrame
    
    -- Shadow/Stroke
    local Stroke = Instance.new("UIStroke")
    Stroke.Color = Color3.fromRGB(60, 60, 80)
    Stroke.Thickness = 2
    Stroke.Parent = MainFrame
    
    -- Title Bar (Draggable)
    local TitleBar = Instance.new("Frame")
    TitleBar.Name = "TitleBar"
    TitleBar.Size = UDim2.new(1, 0, 0, 50)
    TitleBar.BackgroundColor3 = Color3.fromRGB(35, 35, 50)
    TitleBar.BorderSizePixel = 0
    TitleBar.Parent = MainFrame
    
    local TitleCorner = Instance.new("UICorner")
    TitleCorner.CornerRadius = UDim.new(0, 12)
    TitleCorner.Parent = TitleBar
    
    -- Make GUI Draggable (supports both mouse and touch)
    local dragging = false
    local dragInput, dragStart, startPos
    
    TitleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = MainFrame.Position
            
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    
    TitleBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            MainFrame.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
    
    -- Title Text
    local TitleLabel = Instance.new("TextLabel")
    TitleLabel.Name = "TitleLabel"
    TitleLabel.Size = UDim2.new(1, -20, 1, 0)
    TitleLabel.Position = UDim2.new(0, 10, 0, 0)
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Text = KeySystemConfig.ScriptName
    TitleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    TitleLabel.TextSize = isMobile and 18 or 20
    TitleLabel.Font = Enum.Font.GothamBold
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
    TitleLabel.TextScaled = isMobile -- Auto-scale on mobile
    TitleLabel.Parent = TitleBar
    
    if isMobile then
        local TitleConstraint = Instance.new("UITextSizeConstraint")
        TitleConstraint.MaxTextSize = 20
        TitleConstraint.MinTextSize = 12
        TitleConstraint.Parent = TitleLabel
    end
    
    -- Subtitle
    local SubtitleLabel = Instance.new("TextLabel")
    SubtitleLabel.Name = "SubtitleLabel"
    SubtitleLabel.Size = UDim2.new(1, -40, 0, 30)
    SubtitleLabel.Position = UDim2.new(0, 20, 0, 60)
    SubtitleLabel.BackgroundTransparency = 1
    SubtitleLabel.Text = KeySystemConfig.Subtitle
    SubtitleLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    SubtitleLabel.TextSize = isMobile and 13 or 14
    SubtitleLabel.Font = Enum.Font.Gotham
    SubtitleLabel.TextXAlignment = Enum.TextXAlignment.Left
    SubtitleLabel.TextScaled = isMobile
    SubtitleLabel.Parent = MainFrame
    
    -- Discord Info
    local DiscordLabel = Instance.new("TextLabel")
    DiscordLabel.Name = "DiscordLabel"
    DiscordLabel.Size = UDim2.new(1, -40, 0, isMobile and 50 or 40)
    DiscordLabel.Position = UDim2.new(0, 20, 0, 95)
    DiscordLabel.BackgroundTransparency = 1
    DiscordLabel.Text = "🔑 Get your key from our Discord server!\nClick the button below to join."
    DiscordLabel.TextColor3 = Color3.fromRGB(150, 150, 200)
    DiscordLabel.TextSize = isMobile and 11 or 12
    DiscordLabel.Font = Enum.Font.Gotham
    DiscordLabel.TextWrapped = true
    DiscordLabel.TextXAlignment = Enum.TextXAlignment.Center
    DiscordLabel.TextScaled = isMobile
    DiscordLabel.Parent = MainFrame
    
    -- Discord Button
    local DiscordButton = Instance.new("TextButton")
    DiscordButton.Name = "DiscordButton"
    DiscordButton.Size = isMobile and UDim2.new(1, -40, 0, 45) or UDim2.new(0, 360, 0, 35)
    DiscordButton.Position = UDim2.new(0, 20, 0, isMobile and 150 or 145)
    DiscordButton.BackgroundColor3 = Color3.fromRGB(88, 101, 242) -- Discord Blurple
    DiscordButton.Text = "📋 Copy Discord Link"
    DiscordButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    DiscordButton.TextSize = isMobile and 15 or 14
    DiscordButton.Font = Enum.Font.GothamBold
    DiscordButton.BorderSizePixel = 0
    DiscordButton.AutoButtonColor = true -- Better touch feedback
    DiscordButton.Parent = MainFrame
    
    local DiscordCorner = Instance.new("UICorner")
    DiscordCorner.CornerRadius = UDim.new(0, 8)
    DiscordCorner.Parent = DiscordButton
    
    -- Key Input Box
    local KeyBox = Instance.new("TextBox")
    KeyBox.Name = "KeyBox"
    KeyBox.Size = isMobile and UDim2.new(1, -40, 0, 50) or UDim2.new(0, 360, 0, 40)
    KeyBox.Position = UDim2.new(0, 20, 0, isMobile and 205 or 190)
    KeyBox.BackgroundColor3 = Color3.fromRGB(35, 35, 50)
    KeyBox.Text = ""
    KeyBox.PlaceholderText = KeySystemConfig.KeyPlaceholder
    KeyBox.PlaceholderColor3 = Color3.fromRGB(100, 100, 120)
    KeyBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    KeyBox.TextSize = isMobile and 16 or 14
    KeyBox.Font = Enum.Font.Gotham
    KeyBox.ClearTextOnFocus = false
    KeyBox.BorderSizePixel = 0
    KeyBox.TextScaled = false -- Don't scale input text
    KeyBox.Parent = MainFrame
    
    local KeyBoxCorner = Instance.new("UICorner")
    KeyBoxCorner.CornerRadius = UDim.new(0, 8)
    KeyBoxCorner.Parent = KeyBox
    
    local KeyBoxStroke = Instance.new("UIStroke")
    KeyBoxStroke.Color = Color3.fromRGB(60, 60, 80)
    KeyBoxStroke.Thickness = 1
    KeyBoxStroke.Parent = KeyBox
    
    -- Submit Button
    local SubmitButton = Instance.new("TextButton")
    SubmitButton.Name = "SubmitButton"
    SubmitButton.Size = isMobile and UDim2.new(1, -40, 0, 50) or UDim2.new(0, 360, 0, 40)
    SubmitButton.Position = UDim2.new(0, 20, 0, isMobile and 265 or 240)
    SubmitButton.BackgroundColor3 = Color3.fromRGB(50, 200, 100)
    SubmitButton.Text = "✓ Submit Key"
    SubmitButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    SubmitButton.TextSize = isMobile and 18 or 16
    SubmitButton.Font = Enum.Font.GothamBold
    SubmitButton.BorderSizePixel = 0
    SubmitButton.AutoButtonColor = true -- Better touch feedback
    SubmitButton.Parent = MainFrame
    
    local SubmitCorner = Instance.new("UICorner")
    SubmitCorner.CornerRadius = UDim.new(0, 8)
    SubmitCorner.Parent = SubmitButton
    
    -- Status Label (for feedback)
    local StatusLabel = Instance.new("TextLabel")
    StatusLabel.Name = "StatusLabel"
    StatusLabel.Size = UDim2.new(1, -40, 0, isMobile and 25 or 20)
    StatusLabel.Position = UDim2.new(0, 20, 1, isMobile and -30 or -25)
    StatusLabel.BackgroundTransparency = 1
    StatusLabel.Text = ""
    StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
    StatusLabel.TextSize = isMobile and 13 or 12
    StatusLabel.Font = Enum.Font.Gotham
    StatusLabel.TextXAlignment = Enum.TextXAlignment.Center
    StatusLabel.TextScaled = isMobile
    StatusLabel.Parent = MainFrame
    
    return ScreenGui, KeyBox, SubmitButton, DiscordButton, StatusLabel
end

-- Show notification
local function ShowNotification(title, text, duration)
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = title,
        Text = text,
        Duration = duration or 5,
    })
end

-- Copy to clipboard
local function CopyToClipboard(text)
    if setclipboard then
        setclipboard(text)
        return true
    elseif syn and syn.write_clipboard then
        syn.write_clipboard(text)
        return true
    elseif Clipboard and Clipboard.set then
        Clipboard.set(text)
        return true
    end
    return false
end

-- Promise implementation (simple)
local Promise = {}
Promise.__index = Promise

function Promise.new(executor)
    local self = setmetatable({}, Promise)
    self._status = "pending"
    self._value = nil
    
    local function resolve(value)
        if self._status == "pending" then
            self._status = "resolved"
            self._value = value
            if self._then then
                self._then(value)
            end
        end
    end
    
    local function reject(reason)
        if self._status == "pending" then
            self._status = "rejected"
            self._value = reason
            if self._catch then
                self._catch(reason)
            end
        end
    end
    
    executor(resolve, reject)
    return self
end

function Promise:andThen(callback)
    self._then = callback
    if self._status == "resolved" then
        callback(self._value)
    end
    return self
end

function Promise:catch(callback)
    self._catch = callback
    if self._status == "rejected" then
        callback(self._value)
    end
    return self
end

-- Main Key System Function
local function ValidateKey()
    return Promise.new(function(resolve, reject)
        local Players = game:GetService("Players")
        local LocalPlayer = Players.LocalPlayer
        local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
        
        -- Check if stored key is valid
        local storedKey = GetStoredKey()
        if storedKey and storedKey == KeySystemConfig.CorrectKey then
            -- Key is valid and hasn't changed, auto-validate
            ShowNotification("Key Validated", "Welcome back! Loading script...", 3)
            task.wait(0.5)
            resolve(true)
            return
        elseif storedKey and storedKey ~= KeySystemConfig.CorrectKey then
            -- Key has changed, clear old key
            ClearStoredKey()
        end
        
        -- Create GUI
        local ScreenGui, KeyBox, SubmitButton, DiscordButton, StatusLabel = CreateKeyGUI()
        ScreenGui.Parent = PlayerGui
        
        local keyValidated = false
        
        -- Discord Button Click
        DiscordButton.MouseButton1Click:Connect(function()
            if CopyToClipboard(KeySystemConfig.DiscordLink) then
                StatusLabel.Text = "Discord link copied to clipboard!"
                StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
                ShowNotification("Discord Link Copied", "Paste it in your browser to join!", 5)
            else
                StatusLabel.Text = "Discord: " .. KeySystemConfig.DiscordLink
                StatusLabel.TextColor3 = Color3.fromRGB(150, 150, 200)
            end
            
            task.delay(3, function()
                if not keyValidated then
                    StatusLabel.Text = ""
                end
            end)
        end)
        
        -- Submit Button Click
        SubmitButton.MouseButton1Click:Connect(function()
            local enteredKey = KeyBox.Text
            
            if enteredKey == "" then
                StatusLabel.Text = "⚠ Please enter a key"
                StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
                return
            end
            
            if enteredKey == KeySystemConfig.CorrectKey then
                keyValidated = true
                StatusLabel.Text = "✓ Key validated! Loading script..."
                StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
                
                -- Save the key for future use
                local saveSuccess = SaveKey(enteredKey)
                if saveSuccess then
                    ShowNotification("Key Accepted & Saved", "You won't need to enter it again! Loading...", 3)
                else
                    ShowNotification("Key Accepted", "Loading " .. KeySystemConfig.ScriptName .. "...", 3)
                end
                
                task.wait(1)
                ScreenGui:Destroy()
                resolve(true)
            else
                StatusLabel.Text = "Invalid key! Get the key from Discord."
                StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
                KeyBox.Text = ""
                
                -- Shake animation
                local originalPos = SubmitButton.Position
                for i = 1, 3 do
                    SubmitButton.Position = originalPos + UDim2.new(0, 10, 0, 0)
                    task.wait(0.05)
                    SubmitButton.Position = originalPos - UDim2.new(0, 10, 0, 0)
                    task.wait(0.05)
                end
                SubmitButton.Position = originalPos
            end
        end)
        
        -- Enter key support
        KeyBox.FocusLost:Connect(function(enterPressed)
            if enterPressed then
                SubmitButton.MouseButton1Click:Fire()
            end
        end)
    end)
end

-- Export
return {
    Config = KeySystemConfig,
    Validate = ValidateKey,
}
